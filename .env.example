# ─── Odds Provider ────────────────────────────────────────────────────────────
# Pilih salah satu: "the_odds_api" atau "odds_api_io"
ODDS_PROVIDER=odds_api_io

# ─── The Odds API (https://the-odds-api.com) ──────────────────────────────────
THE_ODDS_API_KEY=

# ─── Odds-API.io (https://odds-api.io) ────────────────────────────────────────
ODDS_API_IO_KEY=
ODDS_API_IO_BOOKMAKERS=Bet365,Unibet
ODDS_API_IO_MAX_EVENTS=30

# ─── AI Enrichment (opsional) ─────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=

# GitHub Models: https://github.com/settings/tokens
GITHUB_TOKEN=

# Ollama (cloud): https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ─── Tracker ──────────────────────────────────────────────────────────────────
# football-data.org (gratis): https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
